{
  "schemaVersion": "0.3.0-alpha",
  "programId": "western-blot-sds-page",
  "name": "Western Blot: SDS-PAGE, Wet Transfer and Overnight Primary",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "sample-prep",
      "name": "Sample Preparation",
      "steps": [
        {
          "stepId": "thaw-lysates",
          "name": "Thaw lysates on ice and normalize",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Thaw the lysates on ice and normalise them to 2 mg/mL; 15 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "denature-samples",
          "name": "Denature samples in heat block",
          "task": "heat block",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-lysates"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 4× Laemmli buffer and denature at 95 °C for 5 minutes in the heat block.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "spin-tubes",
          "name": "Spin tubes in microcentrifuge",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "denature-samples"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Spin the tubes for 2 minutes in the microcentrifuge to collect condensate.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-prep-and-run",
      "name": "Gel Preparation and Running",
      "steps": [
        {
          "stepId": "assemble-gel-tank",
          "name": "Assemble gel tank",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "spin-tubes"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Assemble the tank, seat the precast gel and fill with running buffer; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load gel",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-gel-tank"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load 20 µg per lane and 5 µL of protein ladder; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel",
          "task": "gel tank",
          "duration": {
            "type": "fixed",
            "seconds": 4500
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run at 120 V for 75 minutes, until the dye front reaches the foot of the gel.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "transfer-prep-and-blot",
      "name": "Transfer Preparation and Blot",
      "steps": [
        {
          "stepId": "chill-transfer-buffer",
          "name": "Chill transfer buffer in cold room",
          "task": "cold room",
          "duration": {
            "type": "fixed",
            "seconds": 3600
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 3600
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Put a litre of transfer buffer in the cold room an hour before you need it.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-pvdf-membrane",
          "name": "Prepare PVDF membrane",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "chill-transfer-buffer"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "wet a PVDF membrane in methanol for 30 seconds and equilibrate it in transfer buffer; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "soak-fibre-pads",
          "name": "Soak fibre pads and filter paper",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prepare-pvdf-membrane"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Soak the fibre pads and filter paper in cold transfer buffer; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "build-transfer-sandwich",
