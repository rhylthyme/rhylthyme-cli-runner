          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "soak-fibre-pads"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "prise the gel out of the cassette and build the transfer sandwich with no bubbles; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
