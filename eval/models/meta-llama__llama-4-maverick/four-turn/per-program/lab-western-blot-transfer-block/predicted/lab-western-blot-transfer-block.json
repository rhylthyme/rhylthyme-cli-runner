          "stepId": "wash-membrane-2",
          "name": "Wash membrane (second time)",
          "task": "orbital rocker",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wash-membrane-1"
