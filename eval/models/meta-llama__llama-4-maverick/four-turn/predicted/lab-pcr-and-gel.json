{
  "schemaVersion": "0.3.0-alpha",
  "programId": "colony-pcr-screen",
  "name": "Colony PCR Screen with Diagnostic Gel",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "pcr",
      "name": "PCR",
      "steps": [
        {
          "stepId": "thaw-reagents",
          "name": "Thaw primers, dNTPs, and 10× buffer",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Thaw the primers, dNTPs and 10× buffer on ice; 15 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "assemble-master-mix",
          "name": "Assemble master mix",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-reagents"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Assemble a 25 µL master mix on ice for eight reactions plus one spare; 10 minutes of pipetting.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "aliquot-reactions",
          "name": "Aliquot reactions and spin down",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-master-mix"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aliquot 25 µL into eight strip tubes, add 1 µL of each colony suspension and spin them down for 30 seconds in the microcentrifuge; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-thermocycler",
          "name": "Load thermocycler and start program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "aliquot-reactions"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the strip tubes into the thermocycler and start the program; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "pcr-cycling",
          "name": "PCR cycling",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 6600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run 95 °C for 3 minutes, then 35 cycles of 95 °C for 30 seconds, 58 °C for 30 seconds and 72 °C for 45 seconds, then a final 72 °C for 5 minutes. The block reports 1 hour 50 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "add-loading-dye",
          "name": "Add loading dye to PCR products",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pcr-cycling"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "add 5 µL of loading dye to each; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-prep",
      "name": "Gel Preparation",
      "steps": [
        {
          "stepId": "weigh-agarose",
          "name": "Weigh agarose",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler",
            "offsetSeconds": 1500
          },
          "metadata": {
            "sourceSpan": {
              "quote": "weigh 1.0 g of agarose into 100 mL of 1× TAE",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "microwave-agarose",
          "name": "Microwave agarose",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "weigh-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "microwave for 3 minutes, swirling once, until no lens of undissolved agarose is left.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "cool-agarose",
          "name": "Cool agarose",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 720
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "microwave-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 12 minutes, until it is comfortable to hold.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "pour-gel",
          "name": "Pour gel",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 5 µL of DNA stain, pour the gel into the casting tray and seat the 10-well comb; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "gel-setting",
          "name": "Let gel set",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 2100
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 35 minutes at room temperature.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-gel-rig",
          "name": "Prepare gel rig",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "gel-setting"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Remove the comb and place the gel in the rig under 1× TAE; 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-run",
      "name": "Gel Run and Analysis",
      "steps": [
        {
          "stepId": "thaw-ladder",
          "name": "Thaw ladder and mix with loading dye",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel",
            "offsetSeconds": 600
          },
          "metadata": {
            "sourceSpan": {
              "quote": "thaw the 100 bp ladder and mix it with 6× loading dye; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load gel",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "prepare-gel-rig"
              },
              {
                "type": "afterStep",
                "stepId": "thaw-ladder"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load 10 µL per well alongside 5 µL of ladder; 8 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel",
          "task": "gel rig",
          "duration": {
            "type": "fixed",
            "seconds": 2400
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 120 V for 40 minutes, until the dye front is two-thirds down.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image gel",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "record-clones",
          "name": "Record clones and mark plate",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "image-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Record which clones carry the insert and mark the plate; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    }
  ],
