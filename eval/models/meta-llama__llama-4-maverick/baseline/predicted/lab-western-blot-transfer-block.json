      "task": "gel-tank",
      "maxConcurrent": 1
    },
    {
      "task": "wet-transfer-tank",
      "maxConcurrent": 1
    },
    {
      "task": "orbital-rocker",
      "maxConcurrent": 1
    },
    {
      "task": "cold-room",
      "maxConcurrent": 1
    },
    {
      "task": "chemiluminescence-imager",
      "maxConcurrent": 1
    },
    {
      "task": "heat-block",
      "maxConcurrent": 1
    },
    {
      "task": "microcentrifuge",
      "maxConcurrent": 1
    },
    {
      "task": "prep",
      "maxConcurrent": 1
    }
  ]
