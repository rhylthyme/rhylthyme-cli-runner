        {
          "stepId": "prepare-pvdf",
          "name": "Prepare PVDF membrane",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel",
            "offsetSeconds": 0
          }
        },
        {
          "stepId": "soak-fibre-pads",
          "name": "Soak fibre pads and filter paper",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prepare-pvdf"
          }
        }
      ]
    },
    {
      "trackId": "blot-and-probe",
      "name": "Blot and Probe",
      "steps": [
        {
          "stepId": "assemble-transfer-sandwich",
          "name": "Assemble transfer sandwich",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel",
            "offsetSeconds": 300
