          "startTrigger": {
            "type": "afterStep",
            "stepId": "probe-secondary"
          }
        },
        {
          "stepId": "image-blot",
          "name": "Image blot",
          "task": "chemiluminescence-imager",
          "duration": {
            "type": "fixed",
            "seconds": 600
