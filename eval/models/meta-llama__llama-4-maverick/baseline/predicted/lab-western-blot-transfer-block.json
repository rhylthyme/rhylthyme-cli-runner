        {
          "stepId": "wash-primary",
          "name": "Wash primary antibody",
          "task": "orbital-rocker",
          "replicates": {
            "count": 3,
            "mode": "serial",
            "delay": "10m"
          },
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "probe-primary"
          }
        },
        {
          "stepId": "probe-secondary",
          "name": "Probe with secondary antibody",
          "task": "orbital-rocker",
          "duration": {
            "type": "fixed",
            "seconds": 3600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wash-primary",
            "instances": "all"
          }
        },
        {
          "stepId": "wash-secondary",
          "name": "Wash secondary antibody",
          "task": "orbital-rocker",
          "replicates": {
            "count": 3,
            "mode": "serial",
            "delay": "10m"
          },
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "probe-secondary"
          }
        }
      ]
    },
    {
      "trackId": "detection",
      "name": "Detection",
      "steps": [
        {
          "stepId": "mix-ecl",
          "name": "Mix ECL substrate",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
