          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wet-transfer"
          }
        },
        {
          "stepId": "block-membrane",
          "name": "Block membrane",
          "task": "orbital-rocker",
          "duration": {
            "type": "fixed",
            "seconds": 3600
