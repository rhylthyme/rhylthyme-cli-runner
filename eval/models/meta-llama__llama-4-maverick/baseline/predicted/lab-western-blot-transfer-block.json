{
  "schemaVersion": "0.3.0-alpha",
  "programId": "western-blot-sds-page-wet-transfer-overnight-primary",
  "name": "Western Blot: SDS-PAGE, Wet Transfer and Overnight Primary",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "sample-prep",
      "name": "Sample Preparation",
      "steps": [
        {
          "stepId": "thaw-lysates",
          "name": "Thaw lysates and normalize",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "denature-samples",
          "name": "Denature samples",
          "task": "heat-block",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-lysates"
          }
        },
        {
          "stepId": "spin-samples",
          "name": "Spin samples",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "denature-samples"
          }
        }
      ]
    },
    {
      "trackId": "gel-prep-and-run",
      "name": "Gel Preparation and Run",
      "steps": [
        {
          "stepId": "assemble-gel-tank",
          "name": "Assemble gel tank",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "spin-samples"
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load gel",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-gel-tank"
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel",
          "task": "gel-tank",
          "duration": {
            "type": "fixed",
            "seconds": 4500
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          }
        }
      ]
    },
    {
      "trackId": "transfer-prep",
      "name": "Transfer Preparation",
