                "stepId": "bacon-drain"
              },
              {
                "type": "afterStep",
                "stepId": "pancake-cook"
              },
              {
                "type": "afterStep",
                "stepId": "fruit-chill"
              },
              {
                "type": "afterStep",
                "stepId": "coffee-brew"
              }
            ]
          }
        }
