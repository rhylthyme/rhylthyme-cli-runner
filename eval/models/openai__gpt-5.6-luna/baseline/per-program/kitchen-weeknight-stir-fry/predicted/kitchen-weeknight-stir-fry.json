          "startTrigger": {
            "type": "afterStep",
            "stepId": "steam-broccoli"
          }
        },
        {
          "stepId": "toss-stir-fry",
          "name": "Return chicken, add sauce, and toss until glossy",
          "task": "wok-burner",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cook-aromatics"
          }
        },
        {
          "stepId": "serve-meal",
          "name": "Serve immediately over fluffed rice",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
