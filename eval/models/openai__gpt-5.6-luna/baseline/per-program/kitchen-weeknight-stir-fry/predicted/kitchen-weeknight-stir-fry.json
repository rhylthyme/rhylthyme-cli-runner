{
  "schemaVersion": "0.3.0-alpha",
  "programId": "weeknight-chicken-broccoli-stir-fry-rice",
  "name": "Weeknight Chicken and Broccoli Stir-Fry with Rice",
  "description": "A 35-minute dinner for two using two burners and one cook. Rice starts first; prep runs during the rice boil and simmer, followed by a quick stir-fry.",
  "environmentType": "kitchen",
  "actors": 1,
  "tracks": [
