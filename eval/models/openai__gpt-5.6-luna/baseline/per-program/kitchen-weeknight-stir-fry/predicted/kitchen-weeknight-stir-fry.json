            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slice-chicken"
          }
        }
      ]
    },
    {
      "trackId": "vegetable-prep",
      "name": "Vegetables and sauce",
      "steps": [
        {
          "stepId": "prep-vegetables",
          "name": "Cut broccoli and mince garlic and ginger",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slice-chicken"
          }
        },
        {
          "stepId": "mix-sauce",
          "name": "Mix soy sauce, oyster sauce, sugar, and rice vinegar",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prep-vegetables"
          }
        }
      ]
    },
