          "name": "Rinse jasmine rice until water runs clear",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "bring-rice-to-boil",
          "name": "Bring rice and water to a boil",
          "task": "rice-burner",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rinse-rice"
          }
        },
        {
          "stepId": "simmer-rice",
          "name": "Cover and simmer rice on low",
