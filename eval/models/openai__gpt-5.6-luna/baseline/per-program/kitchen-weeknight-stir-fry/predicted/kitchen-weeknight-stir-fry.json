          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "bring-rice-to-boil"
          }
        },
        {
          "stepId": "steam-rice",
          "name": "Remove from heat and steam with lid on",
          "task": "rice-burner",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-rice"
          }
        },
        {
          "stepId": "fluff-rice",
          "name": "Fluff rice with a fork",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 60
