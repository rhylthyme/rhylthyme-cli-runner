  "resourceConstraints": [
    {
      "task": "prep",
      "maxConcurrent": 1
    },
    {
      "task": "counter",
      "maxConcurrent": 1
    },
    {
      "task": "rice-burner",
      "maxConcurrent": 1
    },
    {
      "task": "wok-burner",
      "maxConcurrent": 1
    }
  ],
  "metadata": {
    "serves": "2",
