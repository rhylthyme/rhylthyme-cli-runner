          "task": "baker",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "bulk-first-segment"
          }
        },
        {
          "stepId": "bulk-second-segment",
          "name": "Bulk ferment before second fold",
          "task": "fermentation",
          "duration": {
            "type": "fixed",
            "seconds": 1800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "fold-one"
          }
        },
        {
          "stepId": "fold-two",
          "name": "Second fold",
          "task": "baker",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "bulk-second-segment"
          }
        },
        {
          "stepId": "bulk-third-segment",
          "name": "Bulk ferment before third fold",
          "task": "fermentation",
          "duration": {
            "type": "fixed",
            "seconds": 1800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "fold-two"
          }
        },
        {
          "stepId": "fold-three",
          "name": "Third fold",
          "task": "baker",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "bulk-third-segment"
          }
        },
        {
          "stepId": "bulk-final-segment",
