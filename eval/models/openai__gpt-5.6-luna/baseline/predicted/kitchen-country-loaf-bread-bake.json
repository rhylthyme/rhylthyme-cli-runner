          "duration": {
            "type": "fixed",
            "seconds": 3000
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "score-load",
            "instances": "each"
          }
        },
        {
          "stepId": "cool-loaf",
          "name": "Cool loaf on a rack for at least one hour",
          "task": "cooling-rack",
          "duration": {
            "type": "fixed",
            "seconds": 3600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "bake-loaf",
            "instances": "each"
          }
        },
        {
          "stepId": "loaves-ready",
          "name": "Both loaves are cooled and ready to cut",
          "task": "baker",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-loaf",
            "instances": "all"
          }
        }
      ]
    },
    {
      "trackId": "levain",
      "name": "Levain ripening",
      "steps": [
