          "stepId": "weigh-ingredients",
          "name": "Weigh flour, water, and salt for the whole bake",
          "task": "baker",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "mix-levain",
          "name": "Mix ripe starter, flour, and water",
          "task": "baker",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "weigh-ingredients"
          }
        },
