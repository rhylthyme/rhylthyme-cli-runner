{
  "schemaVersion": "0.3.0-alpha",
  "programId": "country-loaf-two-boules-one-dutch-oven",
  "name": "Country Loaf: Two Boules, One Dutch Oven",
  "description": "One batch of dough shaped into two 900 g boules, retarded overnight, and baked sequentially in one Dutch oven.",
  "environmentType": "kitchen",
  "actors": 1,
  "tracks": [
