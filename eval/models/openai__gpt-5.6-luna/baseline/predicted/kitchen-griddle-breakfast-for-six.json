            "type": "fixed",
            "seconds": 360
          },
          "replicates": {
            "count": 3,
            "mode": "serial"
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "clean-griddle"
              },
              {
                "type": "afterStep",
                "stepId": "rest-batter"
              }
            ]
          }
        },
        {
          "stepId": "settle-griddle",
          "name": "Lower griddle to 300°F and let it settle",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pancake-passes",
            "instances": "all"
          }
        },
        {
          "stepId": "scramble-eggs",
          "name": "Scramble eggs slowly",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 420
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "settle-griddle"
          }
        }
      ]
    },
    {
      "trackId": "toast",
