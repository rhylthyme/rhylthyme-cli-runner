          "task": "toaster",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "replicates": {
            "count": 2,
            "mode": "serial"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pancake-passes",
            "instances": "all",
            "event": "start"
          }
        },
        {
          "stepId": "butter-toast",
          "name": "Butter all toast",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "toast-batches",
            "instances": "all"
          }
        }
      ]
    },
    {
      "trackId": "coffee",
      "name": "Coffee",
      "steps": [
        {
          "stepId": "grind-coffee",
          "name": "Grind the beans",
          "task": "grinder",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cook-bacon",
            "event": "start",
            "offsetSeconds": 600
          }
        },
        {
          "stepId": "brew-coffee",
          "name": "Brew a full pot",
          "task": "coffee-maker",
          "duration": {
            "type": "fixed",
            "seconds": 540
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "grind-coffee"
          }
        }
      ]
    },
    {
      "trackId": "plates",
      "name": "Warm plates",
      "steps": [
        {
          "stepId": "warm-plates",
          "name": "Warm six plates in the lowest oven setting",
          "task": "oven",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 31500
          }
        }
      ]
    },
    {
      "trackId": "serve",
      "name": "Serve",
      "steps": [
        {
          "stepId": "call-and-carry",
          "name": "Call everyone and carry the warm plates through",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "scramble-eggs"
              },
              {
                "type": "afterStep",
                "stepId": "butter-toast"
              },
              {
                "type": "afterStep",
                "stepId": "brew-coffee"
              },
              {
                "type": "afterStep",
                "stepId": "warm-plates"
              }
            ]
          }
        }
      ]
    }
