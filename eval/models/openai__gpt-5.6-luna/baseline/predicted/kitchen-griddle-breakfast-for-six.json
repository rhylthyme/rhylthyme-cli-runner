{
  "schemaVersion": "0.3.0-alpha",
  "programId": "breakfast-for-six-one-griddle",
  "name": "Breakfast for Six on One Griddle",
  "description": "Coordinated breakfast for six, completed by 09:00 using one griddle, one two-slice toaster, one coffee maker, one low oven, and one cook.",
  "environmentType": "kitchen",
  "actors": 1,
  "tracks": [
    {
      "trackId": "prep",
      "name": "Breakfast preparation",
      "steps": [
        {
          "stepId": "mix-batter",
          "name": "Whisk pancake dry ingredients and beat in buttermilk and eggs",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 24000
          }
        },
        {
          "stepId": "rest-batter",
          "name": "Let pancake batter stand",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "mix-batter"
          }
        },
        {
          "stepId": "season-eggs",
          "name": "Crack and season a dozen eggs",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rest-batter"
          }
        },
        {
          "stepId": "set-table",
          "name": "Set the table for six",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "season-eggs"
          }
        }
      ]
    },
    {
      "trackId": "griddle",
      "name": "Griddle",
      "steps": [
        {
          "stepId": "heat-griddle",
          "name": "Heat griddle to 375°F",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 28260
          }
        },
        {
          "stepId": "cook-bacon",
          "name": "Cook bacon, turning once",
          "task": "griddle",
          "duration": {
            "type": "fixed",
            "seconds": 840
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "heat-griddle"
          }
        },
        {
          "stepId": "clean-griddle",
          "name": "Scrape and wipe the griddle",
