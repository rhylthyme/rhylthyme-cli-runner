            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rinse-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Start flask B the moment flask A leaves the cabinet: aspirate and rinse with 5 mL of PBS; 4 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "trypsinize-flask-b",
          "name": "Trypsinise flask B",
          "task": "co2-incubator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rinse-flask-b"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Trypsinise flask B in the incubator for 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "neutralize-flask-b",
          "name": "Neutralise flask B",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "neutralize-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Neutralise flask B as soon as flask A is out of the cabinet again; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "spin-flask-b",
          "name": "Spin flask B suspension",
          "task": "centrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "neutralize-flask-b"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Spin flask B at 300 × g for 5 minutes once the centrifuge is free.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "resuspend-flask-b",
          "name": "Resuspend the flask B pellet",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
