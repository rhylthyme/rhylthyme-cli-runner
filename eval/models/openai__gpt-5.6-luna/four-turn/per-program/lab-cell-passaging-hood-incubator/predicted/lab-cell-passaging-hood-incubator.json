            },
            "inferred": false
          }
        },
        {
          "stepId": "check-source-flasks",
          "name": "Check both source flasks",
          "task": "microscope",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prepare-cabinet"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Check both flasks on the microscope for confluence and contamination; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "flask-a",
      "name": "Flask A",
      "steps": [
        {
          "stepId": "rinse-flask-a",
          "name": "Aspirate and rinse flask A",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "check-source-flasks"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aspirate the spent medium and rinse the monolayer with 5 mL of PBS; 4 minutes in the cabinet.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "trypsinize-flask-a",
          "name": "Trypsinise flask A",
          "task": "co2-incubator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rinse-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 2 mL of trypsin-EDTA, rock the flask and return it to the incubator for 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "neutralize-flask-a",
          "name": "Check detachment and neutralise flask A",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "trypsinize-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Knock the flask, check detachment and neutralise with 8 mL of medium; 5 minutes in the cabinet.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "spin-flask-a",
          "name": "Spin flask A suspension",
          "task": "centrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "neutralize-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Transfer the suspension to a 15 mL tube and spin at 300 × g for 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "resuspend-flask-a",
          "name": "Resuspend the flask A pellet",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "spin-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aspirate the supernatant and resuspend the pellet in 10 mL of fresh medium; 4 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "count-flask-a",
          "name": "Count flask A cells",
          "task": "microscope",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "resuspend-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Count the cells on the haemocytometer; 6 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "seed-flask-a",
          "name": "Seed and label two flask A daughter flasks",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "count-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Seed two new T75 flasks at 1:6 and label them; 6 minutes in the cabinet.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "settle-flask-a-daughters",
          "name": "Settle the flask A daughter flasks",
          "task": "co2-incubator",
          "duration": {
            "type": "fixed",
            "seconds": 57600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "seed-flask-a"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Return the new flasks to the incubator and leave them to settle overnight, at least 16 hours.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "flask-b",
      "name": "Flask B",
      "steps": [
        {
          "stepId": "rinse-flask-b",
