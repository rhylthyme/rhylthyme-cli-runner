{
  "schemaVersion": "0.3.0-alpha",
  "programId": "colony-pcr-diagnostic-gel",
  "name": "Colony PCR Screen with a Diagnostic Gel",
  "description": "Screen eight candidate clones by colony PCR and resolve the products on one diagnostic agarose gel.",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "pcr-setup",
      "name": "PCR reaction setup",
      "steps": [
        {
          "stepId": "thaw-pcr-reagents",
          "name": "Thaw primers, dNTPs and buffer on ice",
          "task": "cold-block",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Thaw the primers, dNTPs and 10× buffer on ice; 15 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "assemble-master-mix",
          "name": "Assemble the PCR master mix",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-pcr-reagents"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Assemble a 25 µL master mix on ice for eight reactions plus one spare; 10 minutes of pipetting.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-pcr-tubes",
          "name": "Aliquot master mix and add colony suspensions",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-master-mix"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aliquot 25 µL into eight strip tubes, add 1 µL of each colony suspension and spin them down for 30 seconds in the microcentrifuge; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "spin-pcr-tubes",
          "name": "Spin down the PCR tubes",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 30
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prepare-pcr-tubes"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin them down for 30 seconds in the microcentrifuge",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "pcr-cycling",
      "name": "PCR cycling",
      "steps": [
        {
          "stepId": "load-thermocycler",
          "name": "Load strip tubes and start the PCR program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "spin-pcr-tubes"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the strip tubes into the thermocycler and start the program; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "run-pcr",
          "name": "Run the PCR cycling program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 6600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "The block reports 1 hour 50 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-preparation",
      "name": "Agarose gel preparation",
      "steps": [
        {
          "stepId": "microwave-agarose",
          "name": "Dissolve agarose in TAE",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler",
            "event": "start",
            "offsetSeconds": 1500
          },
          "metadata": {
            "sourceSpan": {
              "quote": "microwave for 3 minutes, swirling once, until no lens of undissolved agarose is left.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "cool-agarose",
          "name": "Cool the agarose solution",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 720
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "microwave-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 12 minutes, until it is comfortable to hold.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "pour-agarose-gel",
          "name": "Add stain, pour the gel and seat the comb",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 5 µL of DNA stain, pour the gel into the casting tray and seat the 10-well comb; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "set-agarose-gel",
          "name": "Let the gel set",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 2100
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-agarose-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 35 minutes at room temperature.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "place-gel-in-rig",
          "name": "Place the gel in the rig under TAE",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-agarose-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Remove the comb and place the gel in the rig under 1× TAE; 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "ladder-preparation",
      "name": "Ladder preparation",
      "steps": [
        {
          "stepId": "thaw-mix-ladder",
          "name": "Thaw the ladder and mix it with loading dye",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-agarose-gel",
            "offsetSeconds": 600
          },
          "metadata": {
            "sourceSpan": {
              "quote": "thaw the 100 bp ladder and mix it with 6× loading dye; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "pcr-product-preparation",
      "name": "PCR product preparation",
      "steps": [
        {
          "stepId": "prepare-pcr-products",
          "name": "Spin down PCR tubes and add loading dye",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-pcr"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "When the cycling finishes, spin the tubes down and add 5 µL of loading dye to each; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-loading-and-readout",
      "name": "Gel loading, imaging and scoring",
      "steps": [
        {
          "stepId": "load-gel",
          "name": "Load PCR products and ladder",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "place-gel-in-rig"
              },
              {
                "type": "afterStep",
                "stepId": "thaw-mix-ladder"
              },
              {
                "type": "afterStep",
                "stepId": "prepare-pcr-products"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load 10 µL per well alongside 5 µL of ladder; 8 minutes. Nothing goes into a well until the gel is in the rig and the ladder is ready.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run the agarose gel",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": 2400
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 120 V for 40 minutes, until the dye front is two-thirds down.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image the gel",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "record-clone-results",
          "name": "Record insert-positive clones and mark the plate",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "image-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Record which clones carry the insert and mark the plate; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    }
  ],
