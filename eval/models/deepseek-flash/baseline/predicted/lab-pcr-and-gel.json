{
  "schemaVersion": "0.3.0-alpha",
  "programId": "colony-pcr-screen-diagnostic-gel",
  "name": "Colony PCR Screen with Diagnostic Gel (8 clones)",
  "description": "Eight colony PCR reactions in one 1 h 50 min thermocycler run. The 1% agarose gel is cast and set during the block (microwave starts 25 min into the run) so it is racked and ready when the tubes come off; the 100 bp ladder thaws 10 min after the gel is poured. One operator, one of each instrument. Makespan ~211 min.",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "reactions",
      "name": "Reaction setup, cycling, post-run",
      "steps": [
        {
          "stepId": "thaw-reagents",
          "name": "Thaw primers, dNTPs, 10x buffer on ice",
          "task": "ice-bucket",
          "duration": {
            "type": "fixed",
            "seconds": "15m"
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "assemble-mastermix",
          "name": "Assemble 25 uL master mix (8 + 1 spare)",
          "task": "pipetting",
          "duration": {
            "type": "fixed",
            "seconds": "10m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-reagents"
          }
        },
        {
          "stepId": "aliquot-and-spin",
          "name": "Aliquot 8 strip tubes, add colony suspension, spin 30 s",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": "5m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-mastermix"
          }
        },
        {
          "stepId": "load-thermocycler",
          "name": "Load strip tubes and start program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": "3m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "aliquot-and-spin"
          }
        },
        {
          "stepId": "pcr-cycling",
          "name": "Cycling: 95C 3m; 35x (95C 30s, 58C 30s, 72C 45s); 72C 5m",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": "1h50m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler"
          }
        },
        {
          "stepId": "add-dye-and-spin",
          "name": "Spin tubes down, add 5 uL loading dye to each",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": "5m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pcr-cycling"
          }
        },
        {
          "stepId": "load-wells",
          "name": "Load 10 uL per well",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": "1m"
          },
          "replicates": {
            "count": 8,
            "mode": "serial"
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "add-dye-and-spin"
              },
              {
                "type": "afterStep",
                "stepId": "gel-into-rig"
              },
              {
                "type": "afterStep",
                "stepId": "thaw-ladder"
              }
            ]
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel at 120 V for 40 min",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": "40m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-wells",
            "instances": "all"
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image gel on transilluminator",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": "5m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          }
        },
        {
          "stepId": "record-results",
          "name": "Record insert-positive clones, mark the plate",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": "10m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "image-gel"
          }
        }
      ]
    },
    {
      "trackId": "gel",
      "name": "Agarose gel (runs during the cycling block)",
      "steps": [
        {
          "stepId": "melt-agarose",
          "name": "Microwave 1.0 g agarose in 100 mL 1x TAE, swirl once",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": "3m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pcr-cycling",
            "event": "start",
            "offsetSeconds": 1500
          }
        },
        {
          "stepId": "cool-flask",
          "name": "Cool flask on bench until comfortable to hold",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": "12m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "melt-agarose"
          }
        },
        {
          "stepId": "pour-gel",
          "name": "Add 5 uL DNA stain, pour gel, seat 10-well comb",
          "task": "casting-tray",
          "duration": {
            "type": "fixed",
            "seconds": "3m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-flask"
          }
        },
        {
          "stepId": "set-gel",
          "name": "Let gel set at room temperature",
          "task": "casting-tray",
          "duration": {
            "type": "fixed",
            "seconds": "35m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel"
          }
        },
        {
          "stepId": "gel-into-rig",
          "name": "Remove comb, place gel in rig under 1x TAE",
          "task": "gel-rig",
          "duration": {
            "type": "fixed",
            "seconds": "2m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-gel"
          }
        }
      ]
    },
    {
      "trackId": "ladder",
      "name": "100 bp ladder",
      "steps": [
        {
          "stepId": "thaw-ladder",
          "name": "Thaw 100 bp ladder and mix with 6x loading dye",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": "5m"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel",
            "offsetSeconds": 600
          }
        }
      ]
    }
  ],
  "resourceConstraints": [
    {
      "task": "thermocycler",
      "maxConcurrent": 1
    },
    {
      "task": "microcentrifuge",
      "maxConcurrent": 1
    },
    {
      "task": "microwave",
      "maxConcurrent": 1
    },
    {
      "task": "gel-rig",
      "maxConcurrent": 1
    },
    {
      "task": "transilluminator",
      "maxConcurrent": 1
    },
    {
      "task": "casting-tray",
      "maxConcurrent": 1
    },
    {
      "task": "ice-bucket",
      "maxConcurrent": 1
    },
    {
      "task": "pipetting",
      "maxConcurrent": 1
    },
    {
      "task": "bench",
      "maxConcurrent": 1
    }
  ],
  "metadata": {
    "sourceUrl": "",
    "attribution": "",
    "notes": "Critical path: thaw 0-15m, mix 15-25m, aliquot/spin 25-30m, load block 30-33m, cycling 33m-2h23m, dye+spin 2h23m-2h28m, wells 2h28m-2h36m, run 2h36m-3h16m, image 3h16m-3h21m, record 3h21m-3h31m. Gel finishes setting at 1h51m, racked at 1h53m, ladder ready at 1h31m - all slack, gated by the 1h50m block."
  }
}
