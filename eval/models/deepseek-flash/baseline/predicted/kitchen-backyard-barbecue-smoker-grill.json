{
  "schemaVersion": "0.3.0-alpha",
  "programId": "backyard-barbecue-smoker-grill",
  "name": "Backyard Barbecue: Smoker and Grill",
  "description": "Pork shoulder owns the offset smoker all day; beans, slaw and the kettle grill run in the last hours and everything meets on the table at 12h00m. Two cooks, one smoker, one kettle, one side burner, one cooler.",
  "environmentType": "kitchen",
  "actors": 2,
  "tracks": [
    {
      "trackId": "smoker",
      "name": "Offset smoker - pork shoulder",
      "steps": [
        {
          "stepId": "lightSmoker",
          "name": "Light the smoker and bring it to 250F",
          "task": "smoker",
          "duration": {
            "type": "fixed",
            "seconds": 2700
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "smokeBark",
          "name": "Smoke the shoulder unwrapped until the bark is dark and set",
          "task": "smoker",
          "duration": {
            "type": "fixed",
            "seconds": 21600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "lightSmoker"
          }
        },
        {
          "stepId": "wrap",
          "name": "Wrap the shoulder tightly in butcher paper",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "smokeBark"
          }
        },
        {
          "stepId": "smokeWrapped",
          "name": "Back on the smoker, wrapped, until the thickest part probes soft",
          "task": "smoker",
          "duration": {
            "type": "variable",
            "minSeconds": 10800,
            "maxSeconds": 14400,
            "defaultSeconds": 10800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wrap"
          }
        },
        {
          "stepId": "holdCooler",
          "name": "Hold the wrapped shoulder in the cooler",
          "task": "cooler",
          "duration": {
            "type": "variable",
            "minSeconds": 3600,
            "maxSeconds": 10800,
            "defaultSeconds": 5400
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "smokeWrapped"
          }
        },
        {
          "stepId": "pull",
          "name": "Pull the meat by hand",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 1800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "holdCooler"
          }
        }
      ]
    },
    {
      "trackId": "rub",
      "name": "Cook 2 - trim and rub while the smoker comes up",
      "steps": [
        {
          "stepId": "trimRub",
          "name": "Trim the shoulder and rub it heavily with salt, pepper and paprika",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 1500
          },
          "startTrigger": {
            "type": "programStart"
          }
        }
      ]
    },
    {
      "trackId": "beans",
      "name": "Side burner - beans",
      "steps": [
        {
          "stepId": "beansBacon",
          "name": "Fry the bacon and onion in the pot on the side burner",
          "task": "sideburner",
          "duration": {
            "type": "fixed",
            "seconds": 720
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "holdCooler",
            "event": "start"
          }
        },
        {
          "stepId": "beansSimmer",
          "name": "Add beans, molasses and drippings; tick over on the lowest flame until you serve",
          "task": "sideburner",
          "duration": {
            "type": "indefinite",
            "defaultSeconds": 6780
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "beansBacon"
          }
        }
      ]
    },
    {
      "trackId": "slaw",
      "name": "Slaw",
      "steps": [
        {
          "stepId": "slawShred",
          "name": "Shred the cabbage and carrot",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "holdCooler",
            "event": "start"
          }
        },
        {
          "stepId": "slawDressing",
          "name": "Whisk the buttermilk dressing",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slawShred"
          }
        },
        {
          "stepId": "slawChill",
          "name": "Dress the slaw and chill it so the cabbage softens",
          "task": "fridge",
          "duration": {
            "type": "variable",
            "minSeconds": 2700,
            "maxSeconds": 7200,
            "defaultSeconds": 5820
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slawDressing"
          }
        }
      ]
    },
    {
      "trackId": "grill",
      "name": "Kettle grill",
      "steps": [
        {
          "stepId": "lightKettle",
          "name": "Light the kettle for a clean bed of coals",
          "task": "kettle",
          "duration": {
            "type": "fixed",
            "seconds": 1500
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 39180
          }
        },
        {
          "stepId": "sausages",
          "name": "Grill the sausages",
          "task": "kettle",
          "duration": {
            "type": "fixed",
            "seconds": 840
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "lightKettle"
          }
        },
        {
          "stepId": "corn",
          "name": "Grill the corn",
          "task": "kettle",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "sausages"
          }
        },
        {
          "stepId": "buns",
          "name": "Toast the buns last so they stay warm",
          "task": "kettle",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "corn"
          }
        }
      ]
    },
    {
      "trackId": "table",
      "name": "Table",
      "steps": [
        {
          "stepId": "setOut",
          "name": "Set out plates, pickles and sauce once the buns are off",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "buns"
          }
        },
        {
          "stepId": "layOut",
          "name": "Call everyone over and lay it all out",
          "task": "prep",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "setOut"
              },
              {
                "type": "afterStep",
                "stepId": "pull"
              }
            ]
          }
        }
      ]
    }
  ],
  "resourceConstraints": [
    {
      "task": "smoker",
      "maxConcurrent": 1
    },
    {
      "task": "kettle",
      "maxConcurrent": 1
    },
    {
      "task": "sideburner",
      "maxConcurrent": 1
    },
    {
      "task": "cooler",
      "maxConcurrent": 1
    },
    {
      "task": "fridge",
      "maxConcurrent": 1
    },
    {
      "task": "prep",
      "maxConcurrent": 2
    }
  ],
  "metadata": {
    "ingredients": [
