      },
      {
        "name": "buttermilk dressing",
        "measure": "1 cup"
      },
      {
        "name": "sausages",
        "measure": "3 lb"
      },
      {
        "name": "corn",
        "measure": "12 ears"
      },
      {
        "name": "buns",
        "measure": "12"
      },
      {
