          "stepId": "b-seed",
          "name": "Flask B seeding",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b-count"
          },
          "metadata": {
            "sourceSpan": {
