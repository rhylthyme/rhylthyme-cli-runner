            },
            "inferred": false
          }
        },
        {
          "stepId": "a-neutralize",
          "name": "Flask A knock and neutralize",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-trypsinize"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Knock the flask, check detachment and neutralise with 8 mL of medium",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "a-spin",
          "name": "Flask A centrifugation",
          "task": "centrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-neutralize"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Transfer the suspension to a 15 mL tube and spin at 300 × g for 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "a-resuspend",
          "name": "Flask A resuspension",
