          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-spin"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aspirate the supernatant and resuspend the pellet in 10 mL of fresh medium",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "a-count",
          "name": "Flask A cell counting",
          "task": "microscope",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-resuspend"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Count the cells on the haemocytometer",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "a-seed",
          "name": "Flask A seeding",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-count"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Seed two new T75 flasks at 1:6 and label them",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "b-rinse",
          "name": "Flask B aspirate and rinse",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-seed"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "aspirate and rinse with 5 mL of PBS",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "b-trypsinize",
          "name": "Flask B trypsin incubation",
          "task": "incubator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b-rinse"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Trypsinise flask B in the incubator for 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "b-neutralize",
          "name": "Flask B neutralize",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b-trypsinize"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Neutralise flask B as soon as flask A is out of the cabinet again",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "b-spin",
          "name": "Flask B centrifugation",
          "task": "centrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b-neutralize"
