          "startTrigger": {
            "type": "afterStep",
            "stepId": "b-spin"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Resuspend the flask B pellet in 10 mL of fresh medium",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "b-count",
          "name": "Flask B cell counting",
          "task": "microscope",
          "duration": {
            "type": "fixed",
            "seconds": 360
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b-resuspend"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Count flask B on the haemocytometer once flask A has been counted",
