    {
      "trackId": "processing-track",
      "name": "Cell Processing",
      "steps": [
        {
          "stepId": "a-rinse",
          "name": "Flask A aspirate and rinse",
          "task": "biosafety-cabinet",
          "duration": {
            "type": "fixed",
            "seconds": 240
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "check-confluence"
              },
              {
                "type": "afterStep",
                "stepId": "warm-reagents"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aspirate the spent medium and rinse the monolayer with 5 mL of PBS",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "a-trypsinize",
          "name": "Flask A trypsin incubation",
          "task": "incubator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a-rinse"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 2 mL of trypsin-EDTA, rock the flask and return it to the incubator for 5 minutes.",
