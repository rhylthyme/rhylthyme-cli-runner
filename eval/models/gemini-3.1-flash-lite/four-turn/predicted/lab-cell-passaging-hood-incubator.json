          "metadata": {
            "sourceSpan": {
              "quote": "Spin flask B at 300 × g for 5 minutes once the centrifuge is free.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "b-resuspend",
          "name": "Flask B resuspension",
          "task": "general-bench",
          "duration": {
            "type": "fixed",
            "seconds": 240
