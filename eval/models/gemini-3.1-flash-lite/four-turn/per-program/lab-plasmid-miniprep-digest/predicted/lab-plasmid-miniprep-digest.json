{
  "schemaVersion": "0.3.0-alpha",
  "programId": "plasmid-miniprep-digest",
  "name": "Plasmid Miniprep, Digest and Gel Check",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "miniprep-digest",
      "name": "Sample Processing",
      "steps": [
        {
          "stepId": "pellet-culture",
          "name": "Pellet the culture",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "centrifuge at 4,000 × g for 10 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "resuspend-pellet",
          "name": "Resuspend the pellet",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pellet-culture"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Resuspend the pellet in 250 µL of Resuspension Buffer (with RNase A) by vortexing; about 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "lysis-incubation",
          "name": "Lysis incubation",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "resuspend-pellet"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "incubate at room temperature for 5 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "spin-lysate",
          "name": "Spin cleared lysate",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "lysis-incubation"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "centrifuge at maximum speed for 10 minutes in the microcentrifuge.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-column",
          "name": "Load column and spin",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "spin-lysate"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the cleared lysate onto a spin column and spin for 1 minute.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "wash-column",
          "name": "Wash column",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-column"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Wash the column with 700 µL of Wash Buffer, spin for 1 minute",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "dry-membrane",
          "name": "Dry the membrane",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "wash-column"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin the empty column for 2 minutes to dry the membrane.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "elute-dna",
          "name": "Elute DNA",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 60
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "dry-membrane"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin for 1 minute to elute.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "measure-concentration",
          "name": "Measure concentration",
          "task": "spectrophotometer",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "elute-dna"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Measure the concentration on the spectrophotometer; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "setup-digest",
          "name": "Setup digest",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "measure-concentration"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "In a 0.2 mL tube combine 500 ng of plasmid, 2 µL of 10× buffer, 0.5 µL each of EcoRI and HindIII, and water to 20 µL; 5 minutes of pipetting.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "digest-37",
          "name": "Digest incubation",
          "task": "heat_block_37",
          "duration": {
            "type": "fixed",
            "seconds": 3600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "setup-digest"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Incubate at 37 °C for 60 minutes in the heat block.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "inactivate-65",
          "name": "Heat inactivation",
          "task": "heat_block_65",
          "duration": {
            "type": "fixed",
            "seconds": 1200
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "digest-37"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Heat-inactivate the enzymes at 65 °C for 20 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "thaw-ladder",
          "name": "Thaw ladder",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "inactivate-65"
          },
          "metadata": {
            "sourceSpan": null,
            "inferred": true
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load gel",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-ladder"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add loading dye to the digest, briefly spin down the tube in the microcentrifuge for 30 seconds, and load 10 µL per well alongside 5 µL of ladder; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel",
          "task": "gel_rig",
          "duration": {
            "type": "fixed",
            "seconds": 2700
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 100 V for 45 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image gel",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator and record band sizes; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-prep",
      "name": "Gel Preparation",
      "steps": [
        {
          "stepId": "dissolve-agarose",
          "name": "Dissolve agarose",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pellet-culture"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "microwave for 2 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "cool-flask",
          "name": "Cool agarose flask",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "dissolve-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 10 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "pour-gel",
          "name": "Pour gel",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-flask"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "pour the gel into the casting tray with the comb in place; 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "set-gel",
          "name": "Set gel",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 1800
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 30 minutes at room temperature",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prep-rig",
          "name": "Prepare gel rig",
          "task": "bench_work",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "remove the comb and place the gel in the rig under 1× TAE; 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    }
  ],
