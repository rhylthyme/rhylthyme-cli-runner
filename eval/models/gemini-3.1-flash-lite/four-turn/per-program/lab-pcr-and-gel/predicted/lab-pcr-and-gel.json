{
  "schemaVersion": "0.3.0-alpha",
  "programId": "colony-pcr-screen",
  "name": "Colony PCR Screen and Diagnostic Gel",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "pcr-track",
      "name": "PCR and Samples",
      "steps": [
        {
          "stepId": "thaw-reagents",
          "name": "Thaw reagents",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Thaw the primers, dNTPs and 10× buffer on ice; 15 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "assemble-master-mix",
          "name": "Assemble master mix",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-reagents"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Assemble a 25 µL master mix on ice for eight reactions plus one spare; 10 minutes of pipetting.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "aliquot-and-prep",
          "name": "Aliquot master mix",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-master-mix"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aliquot 25 µL into eight strip tubes, add 1 µL of each colony suspension",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "spin-samples",
          "name": "Spin samples",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 30
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "aliquot-and-prep"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin them down for 30 seconds in the microcentrifuge; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-thermocycler",
          "name": "Load thermocycler",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "spin-samples"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the strip tubes into the thermocycler and start the program; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "thermocycling",
          "name": "Run PCR program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 6600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "The block reports 1 hour 50 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "post-pcr-spin",
          "name": "Post-PCR spin",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thermocycling"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin the tubes down and add 5 µL of loading dye to each; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-track",
      "name": "Agarose Gel",
      "steps": [
        {
          "stepId": "prepare-agarose",
          "name": "Microwave agarose",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "programStartOffset",
            "offsetSeconds": 1500
          },
          "metadata": {
            "sourceSpan": {
              "quote": "weigh 1.0 g of agarose into 100 mL of 1× TAE and microwave for 3 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "cool-agarose",
          "name": "Cool agarose",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 720
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prepare-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 12 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "pour-gel",
          "name": "Pour gel",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cool-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 5 µL of DNA stain, pour the gel into the casting tray and seat the 10-well comb; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "set-gel",
          "name": "Set gel",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 2100
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "pour-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 35 minutes at room temperature.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-ladder",
          "name": "Prepare ladder",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "set-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "thaw the 100 bp ladder and mix it with 6× loading dye; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-gel-rig",
          "name": "Place gel in rig",
          "task": "gel_rig",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "prepare-ladder"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Remove the comb and place the gel in the rig under 1× TAE; 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load gel",
          "task": "gel_rig",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "post-pcr-spin"
              },
              {
                "type": "afterStep",
                "stepId": "prepare-gel-rig"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load 10 µL per well alongside 5 µL of ladder; 8 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "run-gel",
          "name": "Run gel",
          "task": "gel_rig",
          "duration": {
            "type": "fixed",
            "seconds": 2400
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 120 V for 40 minutes",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "image-gel",
          "name": "Image gel",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "record-results",
          "name": "Record results",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "image-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Record which clones carry the insert and mark the plate; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    }
