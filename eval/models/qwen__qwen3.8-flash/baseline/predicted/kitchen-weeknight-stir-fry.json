{
  "schemaVersion": "0.3.0-alpha",
  "programId": "weeknight-chicken-broccoli-stir-fry-rice",
  "name": "Weeknight Chicken and Broccoli Stir-Fry with Rice",
  "description": "Serves 2. One cook, two burners, about 35 minutes.",
  "environmentType": "kitchen",
  "actors": 1,
  "tracks": [
    {
      "trackId": "rice",
      "name": "Rice",
      "steps": [
        {
          "stepId": "rinse-rice",
          "name": "Rinse rice until clear",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "boil-rice",
          "name": "Bring rice and water to a boil",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rinse-rice"
          }
        },
        {
          "stepId": "simmer-rice",
          "name": "Cover and simmer on low",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "boil-rice"
          }
        },
        {
          "stepId": "steam-rice-off-heat",
          "name": "Remove from heat and steam, lid on",
          "task": "rest",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-rice"
          }
        },
        {
          "stepId": "fluff-rice-and-serve",
          "name": "Fluff rice with a fork and serve",
