          "startTrigger": {
            "type": "afterStep",
            "stepId": "heat-wok"
          }
        },
        {
          "stepId": "steam-broccoli",
          "name": "Add broccoli with a splash of water; cover and steam",
          "task": "burner",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "stir-fry-chicken"
          }
        },
        {
          "stepId": "wok-toss",
          "name": "Add garlic and ginger, return chicken and sauce, toss until glossy",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 90
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "steam-broccoli"
          }
        }
      ]
    }
