      },
      {
        "name": "ginger",
        "measure": "1 thumb"
      },
      {
        "name": "oyster sauce",
        "measure": "1 tbsp"
      },
      {
        "name": "sugar",
        "measure": "1 tsp"
      },
      {
        "name": "rice vinegar",
        "measure": "splash"
      },
      {
        "name": "oil",
