          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slice-chicken"
          }
        },
        {
          "stepId": "stir-sauce",
          "name": "Stir together sauce",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "cut-broccoli-and-aromatics"
          }
        }
      ]
    },
    {
      "trackId": "stir-fry",
      "name": "Stir-fry",
      "steps": [
        {
          "stepId": "heat-wok",
          "name": "Heat wok over highest flame until smoking",
          "task": "cook",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "simmer-rice"
          }
        },
        {
          "stepId": "stir-fry-chicken",
