          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "slice-chicken"
          }
        }
      ]
    },
    {
      "trackId": "broccoli-sauce",
      "name": "Broccoli, aromatics, and sauce",
      "steps": [
        {
          "stepId": "cut-broccoli-and-aromatics",
          "name": "Cut broccoli into florets; mince garlic and ginger",
