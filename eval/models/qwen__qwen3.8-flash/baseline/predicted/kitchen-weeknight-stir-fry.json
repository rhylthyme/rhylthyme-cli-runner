          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "rinse-rice"
          }
        },
        {
          "stepId": "marinate-chicken",
          "name": "Toss chicken with soy sauce and cornstarch; marinate",
