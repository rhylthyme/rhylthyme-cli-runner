{
  "schemaVersion": "0.3.0-alpha",
  "programId": "partner-upper-body-superset",
  "name": "Partner Upper-Body Superset Session",
  "description": "Two-lifter upper-body superset session with bench/barbell, dumbbells, pull-up bar, two ergs, and about 25 minutes total.",
  "environmentType": "gym",
  "actors": 2,
  "tracks": [
    {
      "trackId": "warmup",
      "name": "Warm-up (both partners)",
      "steps": [
        {
          "stepId": "warm_erg",
          "name": "Easy rowing",
          "task": "erg",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "replicates": {
            "count": 2,
            "mode": "parallel"
          },
          "startTrigger": {
            "type": "programStart"
          }
        },
        {
          "stepId": "warm_mobility",
          "name": "Arm circles and band pull-aparts",
          "task": "mobility",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "replicates": {
            "count": 2,
            "mode": "parallel"
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "warm_erg",
            "instances": "all"
          }
        }
      ]
    },
    {
      "trackId": "partnerA",
      "name": "Partner A",
      "steps": [
        {
          "stepId": "a_bench",
          "name": "Bench press - 8 reps",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 40
          },
          "replicates": {
            "count": 2,
            "mode": "stagger",
            "delay": 170
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "warm_mobility",
            "instances": "all"
          }
        },
        {
          "stepId": "a_row",
          "name": "Dumbbell row - 8 per side",
          "task": "dumbbells",
          "duration": {
            "type": "fixed",
            "seconds": 40
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a_bench",
            "instances": "each"
          }
        },
        {
          "stepId": "a_rest",
          "name": "Rest after Superset A round",
          "task": "rest",
          "duration": {
            "type": "fixed",
            "seconds": 90
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a_row",
            "instances": "each"
          }
        },
        {
          "stepId": "a_ohp",
          "name": "Overhead press - 8 reps",
