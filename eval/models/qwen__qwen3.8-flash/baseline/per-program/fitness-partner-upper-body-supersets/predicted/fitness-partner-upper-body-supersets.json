          "startTrigger": {
            "type": "afterStep",
            "stepId": "a_rest",
            "instances": "all"
          }
        },
        {
          "stepId": "a_pullups",
          "name": "Pull-ups - 6 to 10 reps",
          "task": "pullup",
          "duration": {
            "type": "variable",
            "minSeconds": 30,
            "maxSeconds": 45,
            "defaultSeconds": 45
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "a_ohp",
            "instances": "each"
          }
        }
      ]
    },
    {
      "trackId": "partnerB",
      "name": "Partner B",
      "steps": [
        {
          "stepId": "b_row",
          "name": "Dumbbell row - 8 per side",
          "task": "dumbbells",
          "duration": {
            "type": "fixed",
            "seconds": 40
          },
          "replicates": {
            "count": 2,
            "mode": "stagger",
            "delay": 170
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "warm_mobility",
            "instances": "all"
          }
        },
        {
          "stepId": "b_bench",
          "name": "Bench press - 8 reps",
          "task": "bench",
          "duration": {
            "type": "fixed",
            "seconds": 40
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b_row",
            "instances": "each"
          }
        },
        {
          "stepId": "b_rest",
          "name": "Rest after Superset A round",
          "task": "rest",
          "duration": {
            "type": "fixed",
            "seconds": 90
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b_bench",
            "instances": "each"
          }
        },
        {
          "stepId": "b_pullups",
          "name": "Pull-ups - 6 to 10 reps",
          "task": "pullup",
          "duration": {
            "type": "variable",
            "minSeconds": 30,
            "maxSeconds": 45,
            "defaultSeconds": 45
