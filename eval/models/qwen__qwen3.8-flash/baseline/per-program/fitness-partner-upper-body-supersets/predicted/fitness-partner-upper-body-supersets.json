          "startTrigger": {
            "type": "afterStep",
            "stepId": "b_rest",
            "instances": "all"
          }
        },
        {
          "stepId": "b_ohp",
          "name": "Overhead press - 8 reps",
          "task": "dumbbells",
          "duration": {
            "type": "fixed",
            "seconds": 45
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "b_pullups",
            "instances": "each"
          }
        }
      ]
    },
    {
      "trackId": "supersetBRest",
      "name": "Rest between Superset B rounds",
      "steps": [
        {
          "stepId": "b_round_rest",
          "name": "Rest after first Superset B round",
          "task": "rest",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "replicates": {
            "count": 2,
            "mode": "parallel"
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "a_pullups",
                "instances": "any"
              },
              {
                "type": "afterStep",
                "stepId": "b_ohp",
                "instances": "any"
              }
            ]
          }
        }
      ]
    },
    {
      "trackId": "cooldown",
      "name": "Cool-down (both partners)",
      "steps": [
        {
          "stepId": "cool_down",
          "name": "Chest, lat, and shoulder stretch",
          "task": "stretch",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "replicates": {
            "count": 2,
            "mode": "parallel"
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "a_pullups",
                "instances": "all"
              },
              {
                "type": "afterStep",
                "stepId": "b_ohp",
                "instances": "all"
              }
            ]
          }
        }
      ]
    }
