{
  "schemaVersion": "0.3.0-alpha",
  "programId": "colony-pcr-screen-diagnostic-gel",
  "name": "Colony PCR Screen with Diagnostic Gel — Eight Clones",
  "description": "One-operator colony PCR screen for eight clones with a single diagnostic agarose gel. The agarose workflow starts 25 minutes into the PCR run, and gel loading waits for the gel to be in the rig, the ladder to be ready, and the PCR products to be dyed.",
  "environmentType": "laboratory",
  "actors": 1,
  "tracks": [
    {
      "trackId": "operator-bench",
      "name": "Operator bench work",
      "steps": [
        {
          "stepId": "thaw-pcr-reagents",
          "name": "Thaw primers, dNTPs, and buffer on ice",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 900
          },
          "startTrigger": {
            "type": "programStart"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Thaw the primers, dNTPs and 10× buffer on ice; 15 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "assemble-pcr-master-mix",
          "name": "Assemble master mix on ice",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "thaw-pcr-reagents"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Assemble a 25 µL master mix on ice for eight reactions plus one spare; 10 minutes of pipetting.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "aliquot-and-add-colony-suspensions",
          "name": "Aliquot master mix and add colony suspensions",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 270
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "assemble-pcr-master-mix"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Aliquot 25 µL into eight strip tubes, add 1 µL of each colony suspension and spin them down for 30 seconds in the microcentrifuge; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-thermocycler",
          "name": "Load strip tubes into thermocycler and start program",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "aliquot-and-add-colony-suspensions"
              },
              {
                "type": "afterStep",
                "stepId": "spin-colony-pcr-tubes"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load the strip tubes into the thermocycler and start the program; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "pour-agarose-gel",
          "name": "Add DNA stain, pour gel, and seat comb",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "load-thermocycler"
              },
              {
                "type": "afterStep",
                "stepId": "cool-agarose-flask"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Add 5 µL of DNA stain, pour the gel into the casting tray and seat the 10-well comb; 3 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-ladder",
          "name": "Thaw ladder and mix with loading dye",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStepWithBuffer",
            "stepId": "pour-agarose-gel",
            "bufferSeconds": 600
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Ten minutes after the gel is poured to set, thaw the 100 bp ladder and mix it with 6× loading dye; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "transfer-gel-to-rig",
          "name": "Remove comb and place gel in rig under TAE",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 120
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "prepare-ladder"
              },
              {
                "type": "afterStep",
                "stepId": "set-agarose-gel"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Remove the comb and place the gel in the rig under 1× TAE; 2 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "prepare-pcr-products-with-dye",
          "name": "Spin down PCR tubes and add loading dye",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "transfer-gel-to-rig"
              },
              {
                "type": "afterStep",
                "stepId": "run-pcr-cycling"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "When the cycling finishes, spin the tubes down and add 5 µL of loading dye to each; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "load-gel",
          "name": "Load PCR products and ladder into wells",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 480
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "prepare-pcr-products-with-dye"
              },
              {
                "type": "afterStep",
                "stepId": "transfer-gel-to-rig"
              },
              {
                "type": "afterStep",
                "stepId": "prepare-ladder"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Load 10 µL per well alongside 5 µL of ladder; 8 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "record-gel-results",
          "name": "Record clones with inserts and mark plate",
          "task": "operator",
          "duration": {
            "type": "fixed",
            "seconds": 600
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "load-gel"
              },
              {
                "type": "afterStep",
                "stepId": "image-gel"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Record which clones carry the insert and mark the plate; 10 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "microcentrifuge-setup",
      "name": "Microcentrifuge setup spin",
      "steps": [
        {
          "stepId": "spin-colony-pcr-tubes",
          "name": "Spin down colony PCR tubes",
          "task": "microcentrifuge",
          "duration": {
            "type": "fixed",
            "seconds": 30
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "aliquot-and-add-colony-suspensions"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "spin them down for 30 seconds in the microcentrifuge",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "thermocycler-pcr",
      "name": "Thermocycler PCR run",
      "steps": [
        {
          "stepId": "run-pcr-cycling",
          "name": "Run PCR cycling program",
          "task": "thermocycler",
          "duration": {
            "type": "fixed",
            "seconds": 6600
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-thermocycler"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run 95 °C for 3 minutes, then 35 cycles of 95 °C for 30 seconds, 58 °C for 30 seconds and 72 °C for 45 seconds, then a final 72 °C for 5 minutes. The block reports 1 hour 50 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "microwave-agarose",
      "name": "Microwave agarose",
      "steps": [
        {
          "stepId": "microwave-agarose",
          "name": "Microwave agarose solution until dissolved",
          "task": "microwave",
          "duration": {
            "type": "fixed",
            "seconds": 180
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-pcr-cycling",
            "event": "start",
            "offsetSeconds": 1500
          },
          "metadata": {
            "sourceSpan": {
              "quote": "microwave for 3 minutes, swirling once, until no lens of undissolved agarose is left.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-casting-setting",
      "name": "Gel cooling and setting",
      "steps": [
        {
          "stepId": "cool-agarose-flask",
          "name": "Cool agarose flask until comfortable to hold",
          "task": "gel",
          "duration": {
            "type": "fixed",
            "seconds": 720
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "microwave-agarose"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Cool the flask on the bench for 12 minutes, until it is comfortable to hold.",
              "occurrence": 1
            },
            "inferred": false
          }
        },
        {
          "stepId": "set-agarose-gel",
          "name": "Let agarose gel set at room temperature",
          "task": "gel",
          "duration": {
            "type": "fixed",
            "seconds": 2100
          },
          "startTrigger": {
            "type": "compound",
            "logic": "all",
            "triggers": [
              {
                "type": "afterStep",
                "stepId": "cool-agarose-flask"
              },
              {
                "type": "afterStep",
                "stepId": "pour-agarose-gel"
              }
            ]
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Let the gel set for 35 minutes at room temperature.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "gel-rig-run",
      "name": "Gel rig run",
      "steps": [
        {
          "stepId": "run-agarose-gel",
          "name": "Run gel at 120 V",
          "task": "gelRig",
          "duration": {
            "type": "fixed",
            "seconds": 2400
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "load-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Run the gel at 120 V for 40 minutes, until the dye front is two-thirds down.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    },
    {
      "trackId": "transilluminator-imaging",
      "name": "Transilluminator imaging",
      "steps": [
        {
