          "name": "Image gel on transilluminator",
          "task": "transilluminator",
          "duration": {
            "type": "fixed",
            "seconds": 300
          },
          "startTrigger": {
            "type": "afterStep",
            "stepId": "run-agarose-gel"
          },
          "metadata": {
            "sourceSpan": {
              "quote": "Image the gel on the transilluminator; 5 minutes.",
              "occurrence": 1
            },
            "inferred": false
          }
        }
      ]
    }
